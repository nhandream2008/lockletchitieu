# ==== Bien moi truong cho Locket Chi Tieu ====
# Copy file nay thanh .env roi sua lai gia tri

# Cong chay app. Tren hosting panel, PORT thuong duoc cap tu dong -> khong can set.
PORT=3000

# Chuoi bi mat de ky cookie phien dang nhap (BAT BUOC doi khi deploy that)
SESSION_SECRET=doi-chuoi-nay-thanh-mot-chuoi-bi-mat-dai-va-ngau-nhien

# Ten file SQLite (nam trong thu muc project => persistent tren volume container)
DB_FILE=chi_tieu.db
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=expense-images

# Mui gio dung de tinh "hom nay / tuan nay / thang nay"
APP_TZ=Asia/Ho_Chi_Minh

# Kich thuoc anh sau khi nen (px, canh dai nhat) va chat luong JPEG (1-100)
IMAGE_MAX_SIZE=1280
IMAGE_QUALITY=72

# Dat 1 neu chay sau reverse proxy HTTPS (panel/nginx) de cookie secure hoat dong dung
TRUST_PROXY=1
