<%- include('partials/dau') %>
<div class="app">
	<%- include('partials/sidebar') %>
	<main class="noi-dung" id="noi-dung-chinh">
		<%- include('partials/thanh-tren') %>
		<header class="dau-trang">
			<div>
				<span class="eyebrow">MỖI NGÀY MỘT CHÚT CHỦ ĐỘNG</span>
				<h1>Chào <%= user.ten %><span class="chu-grad">, hôm nay thế nào?</span></h1>
				<p class="phu-de"><%= chao ? 'Không gian của bạn đã sẵn sàng. ' : '' %>Ghi lại khoản chi nhỏ, dành chỗ cho những điều lớn hơn.</p>
			</div>
			<a class="nut" href="/dashboard"><i data-lucide="bar-chart"></i><span>Xem thống kê</span></a>
		</header>
		<div class="camera-boc">
			<section class="camera-giua" aria-labelledby="capture-title">
				<div class="capture-heading">
					<div><span class="eyebrow">THÊM MỘT KHOẢN CHI</span><h2 id="capture-title">Lưu lại bằng một bức ảnh</h2></div>
					<div class="capture-mode" aria-label="Nguồn ảnh">
						<button type="button" data-che-do="camera" aria-pressed="true">Camera</button>
						<button type="button" data-che-do="thu-vien" aria-pressed="false">Thư viện</button>
					</div>
				</div>
				<div class="khung-ngam" id="khung-ngam" role="button" tabindex="0" aria-label="Chụp hoặc chọn ảnh khoản chi">
					<span class="luoi-ngam" aria-hidden="true"></span>
					<span class="goc tl" aria-hidden="true"></span><span class="goc tr" aria-hidden="true"></span>
					<span class="goc bl" aria-hidden="true"></span><span class="goc br" aria-hidden="true"></span>
					<div class="giua">
						<span class="vong-sang"><i data-lucide="camera"></i></span>
						<h3>Một lần chụp. Một khoản chi.</h3>
						<div class="chu-goi" id="chu-goi">Chụp món bạn vừa mua, hoặc chọn một bức ảnh từ thư viện.</div>
					</div>
					<span class="capture-stamp" aria-hidden="true">LITTLE MOMENTS. MINDFUL SPENDING.</span>
				</div>
				<div class="thanh-chup">
					<div class="capture-action"><button type="button" class="nut-phu-chup" id="nut-thu-vien" aria-label="Chọn ảnh từ thư viện"><i data-lucide="images"></i></button><span>Thư viện</span></div>
					<div class="capture-action"><button type="button" class="nut-chup" id="nut-chup" aria-label="Chụp ảnh khoản chi"><i data-lucide="camera"></i></button><span id="nhan-nut-chup">Chụp ảnh</span></div>
					<div class="capture-action"><button type="button" class="nut-phu-chup" id="nut-khong-anh" aria-label="Ghi khoản chi không cần ảnh"><i data-lucide="pencil"></i></button><span>Ghi thủ công</span></div>
				</div>
				<p class="capture-help"><i data-lucide="heart"></i> Chụp ảnh hoặc ghi tay, tuỳ bạn. <span class="desktop-shortcut">· <kbd>C</kbd> mở nhanh</span></p>
			</section>
			<aside class="camera-ben">
				<section class="budget-card <%= homNayTomTat.trangThai %>" aria-labelledby="budget-title">
					<div class="the-dau"><h3 id="budget-title">Chiếc ví hôm nay</h3><i data-lucide="wallet"></i></div>
					<div class="budget-summary">
						<div><p class="budget-label"><%= homNayTomTat.conLai < 0 ? 'Đã vượt hạn mức' : 'Bạn còn có thể chi' %></p><div class="budget-number"><%= h.dinhDangSo(Math.abs(homNayTomTat.conLai)) %> <small>₫</small></div></div>
						<div class="budget-ring" role="img" aria-label="Đã dùng <%= homNayTomTat.phanTram %>% hạn mức">
							<svg viewBox="0 0 80 80" aria-hidden="true"><circle class="track" cx="40" cy="40" r="34"/><circle class="value" cx="40" cy="40" r="34" pathLength="100" stroke-dasharray="<%= Math.min(100, Math.max(0, homNayTomTat.phanTram)) %> 100"/></svg>
							<span><%= Math.round(homNayTomTat.phanTram) %>%</span>
						</div>
					</div>
					<div class="budget-footer"><span>Đã chi <b><%= homNayTomTat.tong_dep %></b></span><span>Hạn mức <b><%= homNayTomTat.hanMuc_dep %></b></span></div>
				</section>
				<section class="the recent-card">
					<div class="the-dau"><h3>Vừa ghi gần đây</h3><a class="lien-ket" href="/feed">Xem tất cả <i data-lucide="chevron-right"></i></a></div>
					<% if (!ganNhat.length) { %>
					<div class="recent-empty"><i data-lucide="receipt"></i><span>Nhật ký đang chờ câu chuyện đầu tiên.<br>Ghi một khoản chi để bắt đầu nhé.</span></div>
					<% } else { %>
					<div class="mini-feed">
						<% ganNhat.forEach(function(e) { %>
						<a class="mini-item" href="/feed?loc=tat-ca" aria-label="Xem nhật ký khoản chi <%= e.so_tien_dep %>">
							<% if (e.duong_dan_anh) { %><img class="mini-anh" src="<%= e.duong_dan_anh %>" alt="" loading="lazy" /><% } else { %><span class="mini-anh" aria-hidden="true"><%= e.danh_muc.length ? e.danh_muc[0].icon : '🧾' %></span><% } %>
							<div class="mini-info"><b><%= e.ghi_chu || (e.danh_muc.length ? e.danh_muc[0].ten : 'Khoản chi') %></b><span class="phu"><%= e.ngay_dep %> · <%= e.gio %></span></div>
							<span class="so">−<%= e.so_tien_dep %></span>
						</a>
						<% }) %>
					</div>
					<% } %>
				</section>
			</aside>
		</div>
		<section class="habit-strip">
			<span class="habit-icon"><i data-lucide="flame"></i></span>
			<div><h3><%= thanhTich.chuoi > 0 ? 'Bạn đang giữ nhịp rất tốt!' : 'Một khởi đầu mới cho chiếc ví.' %></h3><p><%= thanhTich.chuoi > 0 ? thanhTich.chuoi + ' ngày liên tiếp trong hạn mức. Cứ từng chút một, bạn nhé.' : 'Một khoản chi được ghi lại là một bước để hiểu thói quen của mình.' %></p></div>
			<a class="lien-ket" href="/dashboard"><%= h.dinhDangSo(thanhTich.diem) %> điểm tiết kiệm <i data-lucide="chevron-right"></i></a>
		</section>
		<footer class="workspace-footer"><span>locket · Chi tiêu có chủ động.</span><span><i data-lucide="heart"></i> Từng khoản nhỏ, từng ngày tốt hơn.</span></footer>
	</main>
	<%- include('partials/nav-duoi') %>
</div>

<input
	type="file"
	id="o-anh"
	class="an"
	accept="image/*"
	capture="environment"
	tabindex="-1"
	aria-hidden="true"
/>

<div class="man-che" id="hop-xac-nhan">
	<div class="hop" role="dialog" aria-modal="true" aria-labelledby="tieu-de-xn">
		<div class="hop-dau">
			<h3 id="tieu-de-xn">Khoản chi mới</h3>
			<button class="nut-icon" type="button" data-dong aria-label="Đóng">
				<i data-lucide="x"></i>
			</button>
		</div>

		<div class="hop-than">
			<img id="xem-truoc" class="anh-xem-truoc an" alt="Ảnh khoản chi vừa chọn" />
			<div id="khong-anh-nhan" class="khong-anh-lon an">
				<i data-lucide="receipt"></i>
				<span>Khoản chi không có ảnh</span>
			</div>

			<div class="o-nhom">
				<label for="o-so-tien">Số tiền đã chi</label>
				<div class="o-tien-boc">
					<input
						id="o-so-tien"
						class="o-nhap o-tien"
						data-tien
						inputmode="numeric"
						autocomplete="off"
						placeholder="0"
					/>
					<span class="don-vi">VNĐ</span>
				</div>
				<div class="goi-y-tien" id="goi-y-tien">
					<button type="button" data-tien="10000">+10.000</button>
					<button type="button" data-tien="20000">+20.000</button>
					<button type="button" data-tien="50000">+50.000</button>
					<button type="button" data-tien="100000">+100.000</button>
					<button type="button" data-tien="200000">+200.000</button>
				</div>
			</div>

			<div class="o-nhom">
				<label>Danh mục <span class="mo nho">(chọn 1 hoặc nhiều)</span></label>
				<div class="hang-tag" id="chip-danh-muc">
					<% dsDanhMuc.forEach(function (d) { %>
					<button
						type="button"
						class="chip"
						data-id="<%= d.id %>"
						style="--mau: <%= d.mau_sac %>"
						aria-pressed="false"
					>
						<span class="cham" style="background: <%= d.mau_sac %>"></span>
						<%= d.icon %> <%= d.ten %>
					</button>
					<% }) %>
					<a class="chip" href="/danh-muc" title="Thêm danh mục mới">
						<i data-lucide="plus"></i> Thêm
					</a>
				</div>
			</div>

			<div class="luoi luoi-2">
				<div class="o-nhom">
					<label for="o-ngay">Ngày chi</label>
					<input
						type="date"
						id="o-ngay"
						class="o-nhap"
						value="<%= homNay %>"
						max="<%= homNay %>"
					/>
				</div>
				<div class="o-nhom">
					<label for="o-ghi-chu">Ghi chú <span class="mo nho">(tuỳ chọn)</span></label>
					<input
						id="o-ghi-chu"
						class="o-nhap"
						maxlength="200"
						placeholder="Cà phê với team..."
					/>
				</div>
			</div>
		</div>

		<div class="hop-chan">
			<button type="button" class="nut day-du" id="nut-luu-feed">Lưu &amp; xem nhật ký</button>
			<button type="button" class="nut nut-chinh day-du" id="nut-luu">Lưu khoản chi</button>
		</div>
	</div>
</div>

<%- include('partials/cuoi', { js: ['/js/camera.js'] }) %>
