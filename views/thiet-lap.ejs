<%- include('partials/dau') %>
<main class="man-auth" id="noi-dung-chinh">
	<%- include('partials/auth-gioi-thieu') %>
	<div class="hop-auth">
		<div class="logo">
			<img class="logo-hinh" src="/img/favicon.svg?v=2" width="42" height="42" alt="" />
			<span class="logo-chu">locket<span>CHI TIÊU CÁ NHÂN</span></span>
		</div>

		<span class="eyebrow">BẮT ĐẦU MỘT THÓI QUEN TỐT</span>
		<h1>Làm quen một chút nhé.</h1>
		<p class="phu-de">
			Đặt một hạn mức mỗi ngày. Locket sẽ giúp bạn theo dõi phần còn lại.
		</p>

		<% if (loi) { %>
		<div class="loi-hop"><i data-lucide="alert-triangle"></i> <%= loi %></div>
		<% } %>

		<form class="form-doc" method="post" action="/thiet-lap">
			<div class="o-nhom">
				<label for="ten">Tên của bạn</label>
				<input
					id="ten"
					name="ten"
					class="o-nhap"
					value="<%= form.ten %>"
					maxlength="40"
					autocomplete="username"
					placeholder="Ví dụ: Minh"
					required
					autofocus
				/>
			</div>

			<div class="luoi luoi-2">
				<div class="o-nhom">
					<label for="mat_khau">Mật khẩu hoặc PIN</label>
					<input
						id="mat_khau"
						name="mat_khau"
						type="password"
						class="o-nhap"
						minlength="4"
						autocomplete="new-password"
						placeholder="ít nhất 4 ký tự"
						required
					/>
				</div>
				<div class="o-nhom">
					<label for="mat_khau_2">Nhập lại</label>
					<input
						id="mat_khau_2"
						name="mat_khau_2"
						type="password"
						class="o-nhap"
						minlength="4"
						autocomplete="new-password"
						required
					/>
				</div>
			</div>

			<div class="o-nhom">
				<label for="han_muc">Hạn mức chi tối đa mỗi ngày</label>
				<div class="o-tien-boc">
					<input
						id="han_muc"
						name="han_muc"
						class="o-nhap o-tien"
						data-tien
						inputmode="numeric"
						value="<%= form.han_muc %>"
						required
					/>
					<span class="don-vi">VNĐ</span>
				</div>
				<p class="nho mo mt-8">
					Ví dụ 150.000 ₫/ngày → ngân sách tuần 1.050.000 ₫, tháng 30 ngày 4.500.000 ₫.
				</p>
			</div>

			<label class="o-chon">
				<input type="checkbox" name="du_lieu_mau" value="1" checked />
				<span>Thêm dữ liệu mẫu để khám phá (có thể xoá sau)</span>
			</label>

			<button type="submit" class="nut nut-chinh day-du">
				<i data-lucide="sparkles"></i><span>Tạo không gian của tôi</span>
			</button>
		</form>

		<% if (daCoUser) { %>
		<div class="chan-auth">
			<span class="mo nho">Đã có tài khoản?</span>
			<a href="/dang-nhap">Đăng nhập</a>
		</div>
		<% } %>
	</div>
</main>
<%- include('partials/cuoi', { js: [] }) %>
